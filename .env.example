# --- обязательное ---
BOT_TOKEN=123456:ABC-DEF...           # токен бота от @BotFather
ANTHROPIC_API_KEY=sk-ant-...          # ключ Claude (можно тот же, что у factbot)

# секрет в URL вебхука: /webhook/<WEBHOOK_SECRET>. На Render генерится автоматом
# (generateValue). Локально (poll.py) не нужен.
WEBHOOK_SECRET=

# --- куда писать ---
# ID группового чата, где живёт бот. Пока пусто — бот НЕ отвечает,
# а в логи пишет id входящих чатов. Скопируй нужный id сюда и перезапусти.
ALLOWED_CHAT_ID=

# --- характер ---
BOT_NAME=Гена
# по каким словам бот понимает, что обращаются к нему (через запятую, в нижнем регистре)
NAME_TRIGGERS=гена,ген,генка,геныч,gena

# --- активность (крутить тут) ---
CHATTINESS=0.50          # базовая вероятность встрять в обычное сообщение (0..1)
QUESTION_BOOST=0.15      # прибавка к вероятности, если в сообщении есть "?"
REPLY_COOLDOWN_SEC=45    # минимум секунд между спонтанными репликами
MAX_REPLIES_PER_HOUR=30  # потолок реплик в час
MAX_REPLIES_PER_DAY=250  # жёсткий потолок в сутки (защита бюджета)

# режим активной беседы: после ответа Жека N секунд «в диалоге» и отвечает
# почти на всё (держит нить), мимо обычного кулдауна
CONVO_WINDOW_SEC=120     # сколько секунд держится режим беседы после его реплики
CONVO_CHATTINESS=0.5     # вероятность ответа внутри активной беседы
CONVO_MIN_GAP=12         # минимум секунд между репликами в беседе (чтобы держал паузу)

# --- модель / экономия токенов ---
MODEL=claude-haiku-4-5
CONTEXT_WINDOW=14        # сколько последних сообщений слать модели
MAX_TOKENS=120          # потолок длины ответа (короче = дешевле и человечнее)
OPINION_CONTEXT=25       # сколько сообщений анализировать, когда спрашивают мнение
OPINION_MAX_TOKENS=280   # лимит длины «развёрнутого» ответа-мнения
